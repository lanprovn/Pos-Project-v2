generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(cuid())
  name         String
  username     String         @unique
  password     String         @default("123456")
  role         String         @default("staff")
  pin          String?
  avatar       String?
  status       String         @default("active")
  createdAt    DateTime       @default(now())
  ShiftSession ShiftSession[]
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  icon     String?
  products Product[]
}

model Product {
  id           String   @id @default(cuid())
  name         String
  price        Float
  costPrice    Float?
  sku          String?  @unique
  barcode      String?  @unique
  categoryName String
  image        String
  stock        Int      @default(0)
  description  String?
  options      String?
  unit         String?  @default("Món")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  category     Category @relation(fields: [categoryName], references: [name])
}

model Customer {
  id         String   @id @default(cuid())
  name       String
  phone      String   @unique
  points     Int      @default(0)
  tier       String   @default("Silver")
  totalSpent Float    @default(0)
  createdAt  DateTime @default(now())
  orders     Order[]
}

model Order {
  id                 String    @id @default(cuid())
  items              String
  total              Float
  subtotal           Float
  discount           Float
  date               DateTime  @default(now())
  status             String    @default("completed")
  cancellationReason String?
  cancelledAt        DateTime?
  cancelledBy        String?
  fulfillmentStatus  String    @default("pending")
  paymentMethod      String    @default("cash")
  diningOption       String    @default("dine-in")
  customerId         String?
  tableId            String?
  customer           Customer? @relation(fields: [customerId], references: [id])
  table              Table?    @relation(fields: [tableId], references: [id])
}

model Table {
  id            String      @id @default(cuid())
  number        Int         @unique
  name          String?
  status        String      @default("available")
  parentTableId String?
  heldOrders    HeldOrder[]
  orders        Order[]
}

model Promotion {
  id            String  @id @default(cuid())
  code          String  @unique
  name          String
  type          String
  value         Float
  minOrderValue Float   @default(0)
  description   String?
  isActive      Boolean @default(true)
  startTime     String?
  endTime       String?
}

model ShiftSession {
  id          String    @id @default(cuid())
  staffId     String
  staffName   String
  startTime   DateTime  @default(now())
  endTime     DateTime?
  initialCash Float
  totalSales  Float     @default(0)
  actualCash  Float?
  difference  Float?
  status      String    @default("open")
  staff       User      @relation(fields: [staffId], references: [id])
}

model HeldOrder {
  id           String   @id @default(cuid())
  customerName String?
  items        String
  diningOption String
  discount     Float
  subtotal     Float
  total        Float
  createdAt    DateTime @default(now())
  tableId      String?
  table        Table?   @relation(fields: [tableId], references: [id])
}
